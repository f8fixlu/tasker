[Unit]
Description=Tasker Webapp Backup Service
After=network.target

[Service]
Type=oneshot
User=tasker
Group=tasker
WorkingDirectory=/opt/tasker/scripts
Environment="RCLONE_CONFIG=/opt/tasker/rclone.conf"
ExecStart=/bin/bash /opt/tasker/scripts/tasker_backup.sh
StandardOutput=append:/opt/tasker/scripts/logs/tasker_backup.log
StandardError=append:/opt/tasker/scripts/logs/tasker_backup.log

# Run daily at 2 AM
OnCalendar=*-*-* 02:00:00
Persistent=true

# Lower I/O and CPU priority to minimize impact on running app
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/tasker/scripts/logs /opt/tasker/status

[Install]
WantedBy=multi-user.target
